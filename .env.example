# ========================================
# DocGenie Environment Configuration
# ========================================
# Copy this file to .env and fill in your values
# DO NOT commit .env to version control

# ========================================
# REQUIRED: API Keys for AI Services
# ========================================

# Cohere API Key (REQUIRED - for embeddings)
# Get your free API key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Google AI Studio API Key (REQUIRED - for LLM)
# Get your free API key from Google AI Studio: https://aistudio.google.com/app/apikey
GOOGLE_API_KEY=your_google_api_key_here

# ========================================
# ChromaDB Configuration
# ========================================

# Directory where ChromaDB stores vector data
# For Docker: Use /app/chroma_db (will be mounted as volume)
# For local: Use ./chroma_db
CHROMA_PERSIST_DIRECTORY=./chroma_db

# ========================================
# Text Processing Settings
# ========================================

# Embedding Model (not currently used, kept for future)
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking Settings
# CHUN
K_SIZE: Maximum characters per chunk
# CHUNK_OVERLAP: Characters of overlap between chunks
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# Retrieval Settings
# DEFAULT_K: Number of documents to retrieve for each query
DEFAULT_K=6

# ========================================
# Server Configuration (Optional)
# ========================================

# Port to run the server on
# PORT=8000

# Host to bind to
# HOST=0.0.0.0

# Number of workers (for production)
# WORKERS=4
