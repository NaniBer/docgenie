# API Key for authentication (optional for now)
API_KEY=your_api_key_here

# Cohere API Key (required for embeddings)
# Get your free API key from: https://dashboard.cohere.com/api-keys
COHERE_API_KEY=your_cohere_api_key_here

# Google AI Studio API Key (alternative)
GOOGLE_API_KEY=your_google_api_key_here

# OpenRouter API Key (alternative)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Embedding Model
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Chunking Settings
CHUNK_SIZE=512
CHUNK_OVERLAP=50
